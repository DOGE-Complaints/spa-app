  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "arkb": "^1.1.61",
    "jsdom": "^28.1.0",
    "puppeteer": "^24.22.3",
    "vite": "^6.0.1",
    "vitest": "^4.0.18"
