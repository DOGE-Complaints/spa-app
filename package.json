    "verify:security": "vitest run && npm run verify:bundle:no-service-role",
    "test:contract:live": "RUN_LIVE_GATEWAY_CONTRACT=1 vitest run src/repositories/__tests__/GatewayIssueRepository.contract.test.js",
    "test:ui:board-shell": "node ./tests/puppeteer/board-shell-smoke.mjs",
    "test:ui:account-summary-cab02": "node ./tests/puppeteer/account-summary-cab02-screenshot.mjs",
