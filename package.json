{
  "name": "dogeestonia-spa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:guard:bundle": "node ./scripts/verify-bundle-no-service-role.mjs",
    "verify:bundle:no-service-role": "vite build && node ./scripts/verify-bundle-no-service-role.mjs",
    "verify:security": "vitest run && npm run verify:bundle:no-service-role",
    "test:contract:live": "RUN_LIVE_GATEWAY_CONTRACT=1 vitest run src/repositories/__tests__/GatewayIssueRepository.contract.test.js",
    "test:ui:board-shell": "node ./tests/puppeteer/board-shell-smoke.mjs",
    "test:ui:status-badge": "node ./tests/puppeteer/status-badge-smoke.mjs",
    "test:ui:i18n": "node ./tests/puppeteer/i18n-switcher-smoke.mjs",
    "test:ui:routing": "node ./tests/puppeteer/routing-behavior-smoke.mjs",
    "test:ui:filters": "node ./tests/puppeteer/filters-and-query-state-smoke.mjs",
    "test:ui:gfl-board": "node ./tests/puppeteer/gfl-driven-board-data-smoke.mjs",
    "test:ui:date-locale": "node ./tests/puppeteer/date-filter-locale-smoke.mjs",
    "test:ui:details": "node ./tests/puppeteer/issue-details-smoke.mjs",
    "test:ui:epic03": "node ./tests/puppeteer/epic03-mockup-validation.mjs",
    "test:ui:auth-login": "node ./tests/puppeteer/auth-login-smoke.mjs",
    "test:ui:verify-host": "node ./tests/puppeteer/verify-page-host-smoke.mjs",
    "test:ui:verify-host:live": "VERIFY_HOST_URL=http://localhost:5173 node ./tests/puppeteer/verify-page-host-smoke.mjs",
    "test:ui:verify-error": "node ./tests/puppeteer/verify-page-error-smoke.mjs",
    "deploy": "node ./scripts/deploy-arweave.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "arkb": "^1.1.61",
    "jsdom": "^28.1.0",
    "puppeteer": "^24.22.3",
    "vite": "^6.0.1",
    "vitest": "^4.0.18"
  }
}
