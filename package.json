{
  "name": "dogeestonia-spa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-4173}",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:guard:bundle": "node ./scripts/verify-bundle-no-service-role.mjs",
