# =============================================================================
# spa-app — пример окружения (.env)
# Скопируйте в `.env` и при необходимости раскомментируйте/измените значения.
#
# ВАЖНО про VITE_*:
#   • Vite пробрасывает в код только переменные с префиксом VITE_ (через import.meta.env).
#   • Значения VITE_* вшиваются на этапе СБОРКИ (npm run build / dev), НЕ на рантайме.
#     После изменения VITE_* нужен перезапуск dev-сервера или пересборка.
# =============================================================================

# -----------------------------------------------------------------------------
# Источник данных доски (главный переключатель)
# Где: src/services/issueService.js:30,34
# -----------------------------------------------------------------------------
# Допустимые значения:
#   FAKE-OLD    — мок-данные (InMemoryIssueRepository + ROUTING_DEMO_ISSUES). Дефолт.
#   GFL-DRIVEN  — реальный бэкенд (GatewayIssueRepository → doge-complaints-gateway).
#
# ⚠️ Сопоставление СТРОГОЕ и регистрозависимое: только ровно `GFL-DRIVEN`
#    включает реальный бэкенд. ЛЮБОЕ другое значение (пусто, опечатка,
#    'gfl-driven', 'real' …) → молча используются моки (FAKE-OLD).
VITE_LIFE_REALITY_MODE=FAKE-OLD

# =============================================================================
# Peer / own URLs (bake) — doge-* HTTP from browser
# VITE_* вшиваются на build/dev start. Никогда не кладите SERVICE_API_TOKEN /
# service_role в VITE_* (только user Bearer + anon). Civic hosts:
#   gateway  https://uus-veerenni-civic-gateway.dogestonia.me
#   identity https://uus-veerenni-civic-identity.dogestonia.me
#   threads  https://uus-veerenni-civic-threads.dogestonia.me
#   spa      https://uus-veerenni-civic-spa.dogestonia.me
# =============================================================================

# --- Own (smoke only; not app runtime) ---------------------------------------
# npm run verify:railway:live / verify-railway-story-submit-smoke.mjs
SPA_BASE_URL=https://uus-veerenni-civic-spa.dogestonia.me

# --- Peers -------------------------------------------------------------------
# Gateway (issues / telemetry / drafts). Required when VITE_LIFE_REALITY_MODE=GFL-DRIVEN.
# Paths: GET {base}/node/issues … (see GatewayIssueRepository). Trim trailing slash/space.
VITE_GATEWAY_BASE_URL=http://127.0.0.1:8000
VITE_GATEWAY_BASE_URL=https://uus-veerenni-civic-gateway.dogestonia.me

# Identity (GET /me, phone, oauth). PROD: missing/blank → fail-fast (HL-04).
VITE_IDENTITY_BASE_URL=http://127.0.0.1:8100
VITE_IDENTITY_BASE_URL=https://uus-veerenni-civic-identity.dogestonia.me

# Threads social HTTP (knobs + tree). Empty → fail-soft Unavailable (no invent localhost in prod).
VITE_THREADS_BASE_URL=http://127.0.0.1:8001
VITE_THREADS_BASE_URL=https://uus-veerenni-civic-threads.dogestonia.me

# ┌─ Рецепт: РЕАЛЬНЫЙ бэкенд ───────────────────────────────────────────────┐
# │ 1) VITE_LIFE_REALITY_MODE=GFL-DRIVEN                                    │
# │ 2) раскомментировать peer URLs выше (local или civic-*)                 │
# │ 3) npm run dev  (или npm run build)                                     │
# │ CORS: gateway/identity must allow this spa origin.                      │
# └────────────────────────────────────────────────────────────────────────┘

# -----------------------------------------------------------------------------
# Телеметрия непереведённых меток (опционально, по умолчанию ВЫКЛ)
# Где: src/i18n/labelMissTelemetry.js:8,15
# -----------------------------------------------------------------------------
# Анонимно сообщает gateway о метках без перевода (humanize-fallback):
#   POST {VITE_GATEWAY_BASE_URL}/telemetry/label-misses  body { label_key, locale }
# Включается только значением ровно 'true' (регистр не важен). Без PII/куки.
# Требует заданного VITE_GATEWAY_BASE_URL — иначе тихий no-op (ничего не шлётся).
VITE_TELEMETRY_ENABLED=true

# -----------------------------------------------------------------------------
# Три полосы запуска (SSOT = package.json + deploy-guide; BUG-07)
# Lane A — local backends: npm run dev (Vite читает .env; default :5173). Рецепт GFL выше.
# Lane B — этот bake: npm run build из текущего .env, затем npm start
#           (package.json "start" = node scripts/start-spa.mjs → serve -s dist после allow)
#           ИЛИ npm run preview (Vite preview того же dist). Не путать start с preview.
# Lane C — Railway/public: npm run verify:build:env-bake перезаписывает dist public URL.
#           После gate НЕ используйте npm start против localhost gateway/identity.
# -----------------------------------------------------------------------------
# PORT для npm start (serve). Если не задан — 4173.
# На Railway/подобных платформах PORT обычно выставляется самой платформой.
# PORT=4173
#
# Публичный URL SPA в рантайме задаёт DNS/Railway; для smoke см. SPA_BASE_URL в блоке Peer/own выше.

# -----------------------------------------------------------------------------
# Supabase Auth (anon only) + identity mock — peer URLs: блок Peer/own выше
# Где: src/auth/supabaseClient.js, src/auth/identityService.js
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
#
# ⚠️ service_role — НИКОГДА на фронте. Не добавляйте VITE_SUPABASE_SERVICE_ROLE
# или любую VITE_*SERVICE_ROLE* переменную: Vite встраивает VITE_* в browser bundle.
# См. docs/requirements/04-env-configuration.md

# Custom GPT URL — веб-кнопки «создать историю» (StorySubmitPage).
VITE_STORY_GPT_URL=https://chatgpt.com/g/your-custom-gpt

# Telegram interview bot URL — How It Works step 02 (M171 / PH-14). Leave empty until handle confirmed; no invent t.me.
# VITE_TELEGRAM_INTERVIEW_URL=

# SPA-side identity mock (dev only). See docs/runtime-docs/manual-smoke-phone-verification.md
#   true  — режим A: /me + phone API mocked in browser
#   false — режим B: real HTTP to VITE_IDENTITY_BASE_URL
VITE_IDENTITY_MOCK_MODE=false

# -----------------------------------------------------------------------------
# Деплой на Arweave (НЕ VITE_*; только для `npm run deploy`)
# Где: scripts/deploy-arweave.mjs:57,72,74-75 (читает process.env, не import.meta.env)
# На работу самого SPA в рантайме НЕ влияют. Нужны только если запускаете деплой.
# -----------------------------------------------------------------------------
# Путь к Arweave-кошельку (ОБЯЗАТЕЛЕН для `npm run deploy`).
#   Рекомендуется хранить файл вне репозитория, напр.:
#   /Users/<you>/.config/dogecomplaints/keys/arweave-wallet.json
ARWEAVE_WALLET_PATH=keys/arweave-wallet.json
# Использовать bundler ('true' включает); иначе прямой аплоад.
ARWEAVE_USE_BUNDLER=false
# URL bundler-ноды (применяется только при ARWEAVE_USE_BUNDLER=true).
ARWEAVE_BUNDLER_NODE=https://node1.bundlr.network
