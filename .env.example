## Option A (recommended): place wallet file outside repo.
## /Users/<your-user>/.config/dogecomplaints/keys/arweave-wallet.json
##
## Option B (current local setup in this project):
## /Users/eslinko/Development/Dogecomplaints/keys/arweave-wallet.json
ARWEAVE_WALLET_PATH=keys/arweave-wallet.json
ARWEAVE_USE_BUNDLER=false
ARWEAVE_BUNDLER_NODE=https://node1.bundlr.network

# Optional anonymous label-miss telemetry (humanize dictionary miss → gateway sink).
# Default off. Requires VITE_GATEWAY_BASE_URL when enabled.
# VITE_TELEMETRY_ENABLED=true
