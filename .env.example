# =============================================================================
# spa-app — пример окружения (.env)
# Скопируйте в `.env` и при необходимости раскомментируйте/измените значения.
#
# ВАЖНО про VITE_*:
#   • Vite пробрасывает в код только переменные с префиксом VITE_ (через import.meta.env).
#   • Значения VITE_* вшиваются на этапе СБОРКИ (npm run build / dev), НЕ на рантайме.
#     После изменения VITE_* нужен перезапуск dev-сервера или пересборка.
# =============================================================================

# -----------------------------------------------------------------------------
# Источник данных доски (главный переключатель)
# Где: src/services/issueService.js:30,34
# -----------------------------------------------------------------------------
# Допустимые значения:
#   FAKE-OLD    — мок-данные (InMemoryIssueRepository + ROUTING_DEMO_ISSUES). Дефолт.
#   GFL-DRIVEN  — реальный бэкенд (GatewayIssueRepository → doge-complaints-gateway).
#
# ⚠️ Сопоставление СТРОГОЕ и регистрозависимое: только ровно `GFL-DRIVEN`
#    включает реальный бэкенд. ЛЮБОЕ другое значение (пусто, опечатка,
#    'gfl-driven', 'real' …) → молча используются моки (FAKE-OLD).
VITE_LIFE_REALITY_MODE=FAKE-OLD

# Базовый URL gateway. БЕЗ пути, можно с/без завершающего слэша (он срезается).
# Где: src/services/issueService.js:31; запросы — GatewayIssueRepository.js:51,59
#   GET {VITE_GATEWAY_BASE_URL}/tallinn/issues
#   GET {VITE_GATEWAY_BASE_URL}/tallinn/issues/{id}
# ОБЯЗАТЕЛЕН в режиме GFL-DRIVEN: при пустом значении репозиторий бросает ошибку
# ('VITE_GATEWAY_BASE_URL is required in GFL-DRIVEN mode'). В FAKE-OLD игнорируется.
# Hygiene: без хвостовых пробелов (trailing whitespace) — иначе URL ломается; assertBaseUrl trim на read path.
# Примеры:
#   Local gateway:    http://localhost:8000
#   Staging:          https://pilot.example.com
#   Prod node:        https://tallinn.dogestonia.example
# VITE_GATEWAY_BASE_URL=http://localhost:8000

# ┌─ Рецепт: работать с РЕАЛЬНЫМ бэкендом ─────────────────────────────────┐
# │ 1) VITE_LIFE_REALITY_MODE=GFL-DRIVEN                                    │
# │ 2) VITE_GATEWAY_BASE_URL=http://localhost:8000  (адрес вашего gateway)  │
# │ 3) перезапустить: npm run dev   (или пересобрать: npm run build)        │
# │ Требование бэка: на gateway должен быть включён CORS для домена SPA.    │
# └────────────────────────────────────────────────────────────────────────┘

# -----------------------------------------------------------------------------
# Телеметрия непереведённых меток (опционально, по умолчанию ВЫКЛ)
# Где: src/i18n/labelMissTelemetry.js:8,15
# -----------------------------------------------------------------------------
# Анонимно сообщает gateway о метках без перевода (humanize-fallback):
#   POST {VITE_GATEWAY_BASE_URL}/telemetry/label-misses  body { label_key, locale }
# Включается только значением ровно 'true' (регистр не важен). Без PII/куки.
# Требует заданного VITE_GATEWAY_BASE_URL — иначе тихий no-op (ничего не шлётся).
# VITE_TELEMETRY_ENABLED=true

# -----------------------------------------------------------------------------
# Хостинг / запуск превью-сервера (опционально)
# Где: package.json → "start": vite preview --host 0.0.0.0 --port ${PORT:-4173}
# -----------------------------------------------------------------------------
# Порт для `npm run start` (прод-превью). Если не задан — 4173.
# На Railway/подобных платформах PORT обычно выставляется самой платформой.
# PORT=4173

# -----------------------------------------------------------------------------
# Identity & Supabase Auth (STORY-SPA-ID-01)
# Где: src/auth/supabaseClient.js, src/auth/identityService.js
# -----------------------------------------------------------------------------
# Supabase project URL + anon key (public; RLS protects data).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# doge-identity-service base URL (GET /me after login).
# VITE_IDENTITY_SERVICE_URL=http://localhost:8100

# Mock identity responses without backend (dev only).
# VITE_IDENTITY_MOCK_MODE=true

# -----------------------------------------------------------------------------
# Деплой на Arweave (НЕ VITE_*; только для `npm run deploy`)
# Где: scripts/deploy-arweave.mjs:57,72,74-75 (читает process.env, не import.meta.env)
# На работу самого SPA в рантайме НЕ влияют. Нужны только если запускаете деплой.
# -----------------------------------------------------------------------------
# Путь к Arweave-кошельку (ОБЯЗАТЕЛЕН для `npm run deploy`).
#   Рекомендуется хранить файл вне репозитория, напр.:
#   /Users/<you>/.config/dogecomplaints/keys/arweave-wallet.json
ARWEAVE_WALLET_PATH=keys/arweave-wallet.json
# Использовать bundler ('true' включает); иначе прямой аплоад.
ARWEAVE_USE_BUNDLER=false
# URL bundler-ноды (применяется только при ARWEAVE_USE_BUNDLER=true).
ARWEAVE_BUNDLER_NODE=https://node1.bundlr.network
